{
  "@context": "https://project-open-data.cio.gov/v1.1/schema/catalog.jsonld",
  "@type": "dcat:Catalog",
  "conformsTo": "https://project-open-data.cio.gov/v1.1/schema",
  "dataset": [
    {
      "identifier": "bill-metadata",
      "title": "Bill Metadata",
      "description": "Bill metadata.json files from formatted snapshots",
      "keyword": ["legislation", "bills", "metadata"],
      "modified": "2024-11-25T00:00:00Z",
      "publisher": {
        "@type": "org:Organization",
        "name": "Windy Civi Project"
      },
      "contactPoint": {
        "@type": "vcard:Contact",
        "fn": "Chi Hack Night",
        "hasEmail": "mailto:info@chihacknight.org"
      },
      "accessLevel": "public",
      "license": "https://creativecommons.org/publicdomain/zero/1.0/",
      "x-filesystem-path": "{jurisdiction}/{session}/bills/{bill_id}-{title}/metadata.json",
      "x-schema-file": "schemas/metadata.schema.json",
      "x-path-parameters": [
        {
          "name": "jurisdiction",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[a-z]{2}$",
            "description": "Jurisdiction code (e.g., wy, il)"
          }
        },
        {
          "name": "session",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^\\d{4}$",
            "description": "Legislative session year (e.g., 2024)"
          }
        },
        {
          "name": "bill_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[A-Z]{2,4}\\d+$",
            "description": "Bill identifier (e.g., SF0001, HB1234)"
          }
        },
        {
          "name": "title",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "description": "URL-safe bill title"
          }
        }
      ]
    },
    {
      "identifier": "bill-action-logs",
      "title": "Bill Action Logs",
      "description": "Each bill's actions, one JSON object per line, append-only (bills/{bill_id}/action_logs.jsonl). Repos not yet converted hold one file per action under bills/{bill_id}/logs/.",
      "keyword": ["legislation", "bills", "actions", "logs"],
      "modified": "2024-11-25T00:00:00Z",
      "publisher": {
        "@type": "org:Organization",
        "name": "Windy Civi Project"
      },
      "contactPoint": {
        "@type": "vcard:Contact",
        "fn": "Chi Hack Night",
        "hasEmail": "mailto:info@chihacknight.org"
      },
      "accessLevel": "public",
      "license": "https://creativecommons.org/publicdomain/zero/1.0/",
      "x-filesystem-path": "country:us/state:{jurisdiction}/sessions/{session}/bills/{bill_id}/action_logs.jsonl",
      "x-schema-file": "schemas/action_log.schema.json",
      "x-path-parameters": [
        {
          "name": "jurisdiction",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[a-z]{2}$",
            "description": "Jurisdiction code (e.g., wy, il)"
          }
        },
        {
          "name": "session",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^\\d{4}$",
            "description": "Legislative session year (e.g., 2024)"
          }
        },
        {
          "name": "bill_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[A-Z]{2,4}\\d+$",
            "description": "Bill identifier (e.g., SF0001, HB1234)"
          }
        }
      ]
    },
    {
      "identifier": "bill-vote-event-logs",
      "title": "Bill Vote Event Logs",
      "description": "Each bill's roll calls, one JSON object per line, append-only; a correction repeats the vote's id (bills/{bill_id}/vote_event_logs.jsonl). Repos not yet converted hold one file per vote under bills/{bill_id}/logs/.",
      "keyword": ["legislation", "bills", "votes", "logs"],
      "modified": "2024-11-25T00:00:00Z",
      "publisher": {
        "@type": "org:Organization",
        "name": "Windy Civi Project"
      },
      "contactPoint": {
        "@type": "vcard:Contact",
        "fn": "Chi Hack Night",
        "hasEmail": "mailto:info@chihacknight.org"
      },
      "accessLevel": "public",
      "license": "https://creativecommons.org/publicdomain/zero/1.0/",
      "x-filesystem-path": "country:us/state:{jurisdiction}/sessions/{session}/bills/{bill_id}/vote_event_logs.jsonl",
      "x-schema-file": "schemas/vote_event_log.schema.json",
      "x-path-parameters": [
        {
          "name": "jurisdiction",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[a-z]{2}$",
            "description": "Jurisdiction code (e.g., wy, il)"
          }
        },
        {
          "name": "session",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^\\d{4}$",
            "description": "Legislative session year (e.g., 2024)"
          }
        },
        {
          "name": "bill_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[A-Z]{2,4}\\d+$",
            "description": "Bill identifier (e.g., SF0001, HB1234)"
          }
        }
      ]
    }
  ]
}
