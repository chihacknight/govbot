{
  "name": "govbot",
  "version": "0.1.0",
  "description": "govbot — streaming pipeline CLI for government legislative data (downloads the prebuilt binary for your platform)",
  "license": "MIT",
  "bin": {
    "govbot": "bin/govbot.js"
  },
  "files": [
    "bin/",
    "helpers/",
